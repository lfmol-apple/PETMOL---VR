[Unit]
Description=PETMOL Shopee sync trigger (fila noturna em prioridades)
After=network.target petmol-api.service
Requires=petmol-api.service

[Service]
Type=oneshot
User=petmol
Group=petmol
# Only fires the HTTP trigger — the sync itself runs in a background thread
# inside petmol-api (see admin/shopee_sync_router.py) and outlives this
# oneshot. source=active_products: fila determinística em prioridades
# (A: ofertas Shopee ativas → B: GTINs usados pelos tutores → C: catálogo
# Awin fresco), deduplicada por GTIN, com teto por execução. Se a API
# externa falhar num GTIN, a oferta antiga é preservada (nunca apagada).
# Ver o trigger script e docs/LAUNCH.md §7.
#
# Inlining the curl call here (rather than calling a script) was tried
# first and failed: systemd's own ExecStart= line parser mangles
# backslash-escaped quotes before bash ever sees them, corrupting the JSON
# body (422 "Expecting property name enclosed in double quotes"). A
# standalone script sidesteps that parser entirely.
ExecStart=/opt/petmol/shared/bin/petmol-shopee-sync-trigger.sh
