[Unit]
Description=Daily PETMOL Shopee sync (Cobasi/Zee Now/Zee Dog feed)

[Timer]
# 05:00 UTC ~= 02:00 America/Sao_Paulo — after petmol-awin-sync.timer.
# If the Awin feed did not refresh, the API trigger refuses this run.
OnCalendar=*-*-* 05:00:00 UTC
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
