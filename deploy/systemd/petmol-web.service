[Unit]
Description=PETMOL Web (Next.js standalone)
After=network.target

[Service]
Type=simple
User=petmol
Group=petmol
WorkingDirectory=/opt/petmol/current/apps/web
EnvironmentFile=-/opt/petmol/shared/env/web.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
