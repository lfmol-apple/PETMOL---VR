<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup/transfer rules. O app guarda o token de sessão e dados do
  tutor no localStorage/IndexedDB do WebView — nada disso deve sair do
  aparelho via Auto Backup do Google nem via transferência device-to-device.
  Combinado com android:allowBackup="false" / fullBackupContent="false"
  para as APIs anteriores.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
