{
  "name": "petmol-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const fs=require('fs');const p='.next/build-manifest.json';try{if(fs.existsSync(p))JSON.parse(fs.readFileSync(p,'utf8'));}catch{console.log('[predev] Cache corrompido — limpando .next');fs.rmSync('.next',{recursive:true,force:true});}\"",
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "NEXT_PUBLIC_API_BASE_URL=/api NEXT_PUBLIC_API_URL=/api next build && cp -r public .next/standalone/apps/web/public && cp -r .next/static .next/standalone/apps/web/.next/static",
    "build:clean": "rm -rf .next && npm run build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@supabase/supabase-js": "^2.91.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "browser-image-compression": "^2.0.2",
    "framer-motion": "^12.29.2",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "next": "^15.5.19",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.6",
    "react-leaflet": "^4.2.1",
    "react-pdf": "^10.4.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "uuid": "^11.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/eslintrc": "^3.3.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.27",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
